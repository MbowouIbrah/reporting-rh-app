# Copier en .env (jamais versionné)
POSTGRES_USER=reporting_rh
POSTGRES_DB=reporting_rh
POSTGRES_PASSWORD=
# 32 caractères minimum : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Compte administrateur créé au démarrage si aucun compte actif ne gère les comptes
# (mot de passe provisoire, 8 car. min, à retirer ensuite)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Mot de passe oublié : lien envoyé par e-mail. APP_URL = adresse publique de l'application
# (ex. https://rh.exemple.com). SMTP_HOST vide : rien n'est envoyé, l'administrateur pose alors
# un mot de passe provisoire depuis Administration > Utilisateurs.
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Accès web : port publié et adresse d'écoute (127.0.0.1 : HTTPS assuré par un proxy sur la machine).
# Ne pas mettre WEB_BIND=0.0.0.0 : seul le proxy doit atteindre ce port.
WEB_PORT=8080
WEB_BIND=127.0.0.1
# false seulement pour un essai en http hors localhost : le cookie de session passerait en clair
COOKIE_SECURE=true

# Sauvegardes (scripts/sauvegarde.sh) : BACKUP_DIR doit pointer vers un disque hors du serveur.
BACKUP_DIR=./backups
RETENTION_JOURS=30
