# Copier en deploy/.env (jamais versionné)
POSTGRES_USER=reporting_rh
POSTGRES_DB=reporting_rh
POSTGRES_PASSWORD=
# 32 caractères minimum : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Compte rh_admin créé au démarrage s'il n'existe pas (mot de passe 8 car. min, à retirer ensuite)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Mot de passe oublié : lien envoyé par e-mail. APP_URL = adresse publique de l'application
# (avec le préfixe, ex. https://serveur/reporting-rh). SMTP_HOST vide : rien n'est envoyé.
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
